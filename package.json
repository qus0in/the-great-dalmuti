{
  "name": "the-great-dalmuti",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "dev": "node --watch --env-file-if-exists=.env src/main.js",
    "test": "node --test",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "browserslist": [
    "cover 95% in KR"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
